# Google Gemini API key (server-only — never exposed to the browser).
# Get one from https://aistudio.google.com/apikey
# Use the PAID tier before any real user's photos are sent (see docs/spec.md
# §7/§10) — the free tier may train on uploaded images.
GEMINI_API_KEY=

# Optional: override the model id (defaults to gemma-3-27b-it — free on Google
# AI Studio for dev/testing). Known, accepted risk: some accounts report Gemma 3
# rejecting image input despite being announced as multimodal — if the review
# call fails with code "image_input_unsupported", set this to gemini-2.5-flash
# instead, which reliably accepts images on every account.
GEMINI_MODEL=

# --- Phase 2 (not wired up yet) ---
# Supabase project URL + anon key, once auth/db/storage are built per docs/spec.md §5a.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
